---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalCard from '../../components/HorizontalCard.astro';

const posts = [
  {
    title: 'Hello World',
    description: 'Welcome to my blog - documenting the tech things I\'ve been working on.',
    href: '/blog/hello-world',
    date: 'Jan 1, 2025',
    tags: ['technology', 'programming', 'personal'],
    icon: '📝',
  },
];
---

<BaseLayout title="Blog" description="Articles, thoughts, and documentation on tech, programming, and AI.">
  <div class="page-header">
    <h1 class="page-title">Blog & Technical Notes</h1>
    <p class="page-description">Documenting thoughts, engineering insights, and tech experiments.</p>
  </div>

  <div class="blog-grid">
    {posts.map(post => (
      <HorizontalCard
        title={post.title}
        description={post.description}
        href={post.href}
        date={post.date}
        tags={post.tags}
        icon={post.icon}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-description {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .blog-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
