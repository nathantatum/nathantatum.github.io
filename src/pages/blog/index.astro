---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const posts = [
  {
    title: 'Hello World',
    description: 'Welcome to my blog - documenting the tech things I\'ve been working on.',
    href: '/blog/hello-world',
    date: '2025-01-01',
  },
];
---

<BaseLayout title="Blog - Nathan Tatum">
  <div class="page-header">
    <h1>Blog</h1>
    <p class="page-subtitle">Thoughts on tech, programming, and more.</p>
  </div>

  <div class="post-list">
    {posts.map(post => (
      <Card
        title={post.title}
        description={post.description}
        href={post.href}
        date={post.date}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: var(--max-width-prose);
  }
</style>
