---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Experience - Nathan Tatum">
  <div class="page-header">
    <h1>Experience</h1>
    <p class="page-subtitle">Work history and professional experience.</p>
  </div>

  <div class="timeline">
    <div class="timeline-item">
      <div class="timeline-marker">
        <div class="timeline-marker-inner"></div>
      </div>
      <div class="timeline-content">
        <div class="timeline-card">
          <span class="timeline-date">Present</span>
          <h3>Software Engineer</h3>
          <p>Building software, exploring new technologies, and contributing to open source.</p>
          <div class="timeline-tags">
            <span class="tag">Python</span>
            <span class="tag">TypeScript</span>
            <span class="tag">Cloud</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .timeline {
    position: relative;
    padding-left: 2.5rem;
    margin-top: 0.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--color-accent), var(--color-accent-2), transparent);
    border-radius: 1px;
    opacity: 0.3;
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-marker {
    position: absolute;
    left: -2.85rem;
    top: 1.5rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2px solid var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-marker-inner {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .timeline-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: box-shadow var(--transition);
  }

  .timeline-card:hover {
    box-shadow: var(--shadow-md);
  }

  .timeline-date {
    font-size: 0.775rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
  }

  .timeline-card h3 {
    margin: 0.75rem 0 0.5rem;
  }

  .timeline-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
</style>
