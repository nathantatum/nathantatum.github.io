---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const skillsEntries = await getCollection('skills');
const skills = skillsEntries
  .map(e => e.data)
  .sort((a, b) => a.order - b.order);

const experienceEntries = await getCollection('experience');
const experiences = experienceEntries
  .flatMap(e => (Array.isArray(e.data) ? e.data : [e.data]))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout title="Experience" description="Career history, technical skills, and background of Nathan Tatum.">
  <div class="page-header">
    <h1 class="page-title">Experience & Skills</h1>
    <p class="page-description">Overview of technical expertise, career progression, and technologies I work with.</p>
  </div>

  <!-- Technical Skills Grid -->
  <section class="section">
    <h2 class="section-title">Technical Skills</h2>
    <div class="skills-grid">
      {skills.map(group => (
        <div class="skill-card">
          <h3 class="skill-category">{group.category}</h3>
          <div class="skill-pills">
            {group.items.map(item => (
              <span class="badge badge-outline">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="section">
    <h2 class="section-title">Work Experience</h2>
    <div class="timeline">
      {experiences.map(exp => (
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <h3 class="timeline-role">{exp.role}</h3>
              <span class="timeline-period">{exp.period}</span>
            </div>
            <p class="timeline-company">{exp.company}</p>
            <p class="timeline-desc">{exp.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-description {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .section {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  /* Skills Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .skill-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .skill-category {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--primary);
  }

  .skill-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 1.5rem;
    border-left: 2px solid var(--border-color);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2rem;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -1.95rem;
    top: 0.25rem;
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--primary);
    border: 3px solid var(--bg-base);
    box-shadow: 0 0 0 2px var(--primary);
  }

  .timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .timeline-role {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .timeline-period {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    background: var(--bg-card);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .timeline-company {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .timeline-desc {
    font-size: 0.925rem;
    color: var(--text-muted);
  }
</style>
