---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalCard from '../components/HorizontalCard.astro';

const projects = [
  {
    title: 'Alembic PoC',
    description: 'Proof of concept exploring Alembic for database migrations, schema evolution, and automated deployment scripts.',
    href: '/projects/alembic-poc',
    badge: 'PoC',
    tags: ['Python', 'Alembic', 'SQL', 'PostgreSQL'],
    icon: '🗄️',
    githubUrl: 'https://github.com/nathantatum/alembic-poc',
  },
  {
    title: 'Portfolio Site',
    description: 'Personal portfolio website built with Astro v5 and static HTML compilation for fast hosting on GitHub Pages.',
    href: '/projects/portfolio-site',
    badge: 'FEATURED',
    tags: ['Astro', 'TypeScript', 'CSS3', 'GitHub Pages'],
    icon: '🌐',
    githubUrl: 'https://github.com/nathantatum/nathantatum.github.io',
  },
];
---

<BaseLayout title="Projects" description="Explore software engineering projects, open-source work, and proof-of-concepts by Nathan Tatum.">
  <div class="page-header">
    <h1 class="page-title">Projects</h1>
    <p class="page-description">A collection of software engineering projects, proof-of-concepts, and tools I've built.</p>
  </div>

  <div class="projects-grid">
    {projects.map(project => (
      <HorizontalCard
        title={project.title}
        description={project.description}
        href={project.href}
        badge={project.badge}
        tags={project.tags}
        icon={project.icon}
        githubUrl={project.githubUrl}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-description {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
