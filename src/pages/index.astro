---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';

const blogPosts = [
  {
    title: 'Hello World',
    description: 'Welcome to my blog - documenting the tech things I\'ve been working on.',
    href: '/blog/hello-world',
    date: '2025-01-01',
  },
];

const projects = [
  {
    title: 'Alembic PoC',
    description: 'Proof of concept exploring Alembic for database migrations.',
    href: '/projects/alembic-poc',
    tags: ['Python', 'Alembic', 'SQL'],
    icon: '\u{1F5C4}',
  },
  {
    title: 'Portfolio Site',
    description: 'This site - built with Astro and deployed to GitHub Pages.',
    href: '/projects/portfolio-site',
    tags: ['Astro', 'TypeScript', 'CSS'],
    icon: '\u{1F310}',
  },
];

const utils = [
  {
    title: 'Raspberry Pi Utilities',
    description: 'Collection of utilities for setting up a Raspberry Pi from scratch.',
    href: '/utils/rpi-utils',
    tags: ['Raspberry Pi', 'Linux'],
    icon: '\u{1F4DF}',
  },
];
---

<BaseLayout title="Nathan Tatum" description="Software engineer - building things, writing about tech.">
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-grid-bg"></div>
    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Building things
      </div>
      <h1 class="hero-title">
        <span class="hero-name">Nathan Tatum</span>
      </h1>
      <p class="hero-tagline">Software engineer building things and writing about tech.</p>
      <div class="hero-links">
        <a href="/projects" class="hero-btn hero-btn-primary">View Projects</a>
        <a href="/blog" class="hero-btn hero-btn-secondary">Read Blog</a>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Projects</h2>
    <div class="grid">
      {projects.map(project => (
        <Card
          title={project.title}
          description={project.description}
          href={project.href}
          tags={project.tags}
          icon={project.icon}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Recent Writing</h2>
    <div class="grid">
      {blogPosts.map(post => (
        <Card
          title={post.title}
          description={post.description}
          href={post.href}
          date={post.date}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Utilities</h2>
    <div class="grid">
      {utils.map(util => (
        <Card
          title={util.title}
          description={util.description}
          href={util.href}
          tags={util.tags}
          icon={util.icon}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 4rem 0 3rem;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(14, 116, 144, 0.08) 0%, rgba(99, 102, 241, 0.06) 40%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    animation: glow-drift 8s ease-in-out infinite alternate;
  }

  @keyframes glow-drift {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-30px, 20px) scale(1.1); }
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(14, 116, 144, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(14, 116, 144, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 60% 60% at 70% 30%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 70% 30%, black 20%, transparent 70%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: var(--color-accent-light);
    border: 1px solid rgba(14, 116, 144, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .hero-name {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tagline {
    margin-top: 1rem;
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 480px;
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.5rem;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all var(--transition);
  }

  .hero-btn:hover {
    text-decoration: none;
  }

  .hero-btn-primary {
    background: var(--gradient-accent);
    color: white;
    box-shadow: 0 2px 10px rgba(14, 116, 144, 0.25);
  }

  .hero-btn-primary:hover {
    box-shadow: 0 4px 20px rgba(14, 116, 144, 0.35);
    transform: translateY(-1px);
  }

  .hero-btn-secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .hero-btn-secondary:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .section {
    margin-top: 4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 0 2rem;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-tagline {
      font-size: 1.05rem;
    }

    .hero-links {
      flex-direction: column;
    }

    .hero-btn {
      justify-content: center;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
