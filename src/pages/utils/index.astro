---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalCard from '../../components/HorizontalCard.astro';

const utilities = [
  {
    title: 'Raspberry Pi Utilities',
    description: 'Collection of utilities and setup scripts for configuring headless Raspberry Pi hardware, networks, and services.',
    href: '/utils/rpi-utils',
    tags: ['Raspberry Pi', 'Linux', 'Automation'],
    icon: '📟',
  },
];
---

<BaseLayout title="Utils" description="Developer utilities, scripts, and hardware configuration tools.">
  <div class="page-header">
    <h1 class="page-title">Developer Utilities</h1>
    <p class="page-description">Scripts, hardware tools, and automation snippets created for personal workflow optimization.</p>
  </div>

  <div class="utils-grid">
    {utilities.map(util => (
      <HorizontalCard
        title={util.title}
        description={util.description}
        href={util.href}
        tags={util.tags}
        icon={util.icon}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-description {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .utils-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
