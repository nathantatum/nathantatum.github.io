---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Nathan Tatum" description="About Nathan Tatum - software engineer.">
  <div class="about-layout">
    <div class="about-header">
      <div class="avatar">
        <span class="avatar-text">NT</span>
      </div>
      <div class="about-intro">
        <h1>About Me</h1>
        <p class="about-tagline">Software engineer who likes building things and learning in public.</p>
      </div>
    </div>

    <div class="about-body prose">
      <section>
        <h2>Hey there</h2>
        <p>
          I'm Nathan -- a software engineer interested in backend systems, developer tooling, and making things work well. I spend most of my time writing Python, but I'm comfortable across the stack and always picking up something new.
        </p>
        <p>
          This site is where I document projects I'm working on, write about technology, and share utilities I've built. It's equal parts portfolio and personal notebook.
        </p>
      </section>

      <section>
        <h2>What I'm Into</h2>
        <div class="interests-grid">
          <div class="interest-card">
            <span class="interest-icon">&#x1F916;</span>
            <h3>AI & ML</h3>
            <p>Following the AI space closely and experimenting with LLMs, agents, and automation.</p>
          </div>
          <div class="interest-card">
            <span class="interest-icon">&#x1F40D;</span>
            <h3>Python</h3>
            <p>My primary language -- from APIs and data pipelines to CLI tools and scripting.</p>
          </div>
          <div class="interest-card">
            <span class="interest-icon">&#x2601;&#xFE0F;</span>
            <h3>Cloud & Infra</h3>
            <p>Building and deploying on cloud platforms, containers, and CI/CD pipelines.</p>
          </div>
          <div class="interest-card">
            <span class="interest-icon">&#x1F4DF;</span>
            <h3>Tinkering</h3>
            <p>Raspberry Pi projects, home automation, and whatever catches my curiosity.</p>
          </div>
        </div>
      </section>

      <section>
        <h2>Elsewhere</h2>
        <div class="links-list">
          <a href="https://github.com/nathantatum" target="_blank" rel="noopener" class="elsewhere-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>GitHub</span>
            <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-layout {
    max-width: var(--max-width-prose);
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .avatar {
    flex-shrink: 0;
    width: 5rem;
    height: 5rem;
    background: var(--gradient-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(14, 116, 144, 0.25);
  }

  .avatar-text {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.5rem;
    color: white;
  }

  .about-intro h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .about-tagline {
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    font-size: 1.05rem;
  }

  .about-body section {
    margin-bottom: 2.5rem;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .interest-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .interest-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .interest-icon {
    font-size: 1.5rem;
    line-height: 1;
    display: block;
    margin-bottom: 0.5rem;
  }

  .interest-card h3 {
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .interest-card p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .links-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .elsewhere-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.925rem;
    transition: all var(--transition);
    max-width: 280px;
  }

  .elsewhere-link:hover {
    text-decoration: none;
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .elsewhere-link .arrow {
    margin-left: auto;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity var(--transition), transform var(--transition);
  }

  .elsewhere-link:hover .arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (max-width: 640px) {
    .about-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .avatar {
      width: 4rem;
      height: 4rem;
    }

    .avatar-text {
      font-size: 1.25rem;
    }

    .interests-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
