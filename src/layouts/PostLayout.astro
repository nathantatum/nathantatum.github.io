---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} - Nathan Tatum`} description={frontmatter.description}>
  <article class="prose">
    <header class="post-header">
      <div class="post-meta">
        {frontmatter.date && <time class="post-date">{frontmatter.date}</time>}
      </div>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="post-desc">{frontmatter.description}</p>}
      {frontmatter.tags && (
        <div class="post-tags">
          {frontmatter.tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
      )}
      <div class="post-divider"></div>
    </header>
    <slot />
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-meta {
    margin-bottom: 0.75rem;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    background: var(--color-accent-light);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .post-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .post-desc {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .post-divider {
    margin-top: 2rem;
    height: 2px;
    background: var(--gradient-accent);
    opacity: 0.15;
    border-radius: 1px;
  }
</style>
